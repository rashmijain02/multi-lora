# Copy to .env. Never commit .env or use real email without authorization.
AZURE_SUBSCRIPTION_ID=REPLACE_ME
AZURE_RESOURCE_GROUP=REPLACE_ME
AZURE_LOCATION=REPLACE_ME
# Lowercase alphanumeric, 5-30 characters, globally unique.
AZURE_CONTAINER_REGISTRY=REPLACE_ME
AZURE_CONTAINER_APP=email-workshop
# Exact HTTPS chat completions URL from your model deployment's Consume page.
# Example shape only: https://RESOURCE.services.ai.azure.com/openai/v1/chat/completions
FOUNDRY_CHAT_COMPLETIONS_URL=REPLACE_ME
FOUNDRY_MODEL=REPLACE_ME
FOUNDRY_API_KEY=REPLACE_ME
# Leave empty for v1; set only if the deployment's API requires it.
FOUNDRY_API_VERSION=
# Opt in only after reviewing data processing, region, and model terms.
ALLOW_REMOTE_EMAIL=false
# Generate a unique random value with at least 32 characters.
WORKSHOP_API_TOKEN=REPLACE_ME
