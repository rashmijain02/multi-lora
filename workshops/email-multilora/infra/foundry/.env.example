# Copy this file to the workshop root as .env.foundry (ignored).
# Separate from the API hosting .env. Never put account keys in this file.
AZURE_SUBSCRIPTION_ID=REPLACE_ME
FOUNDRY_RESOURCE_GROUP=REPLACE_ME
FOUNDRY_LOCATION=REPLACE_ME
# Globally unique lowercase alphanumeric/hyphen subdomain, no trailing hyphen.
FOUNDRY_ACCOUNT_NAME=REPLACE_ME
FOUNDRY_PROJECT_NAME=email-workshop
FOUNDRY_DEPLOYMENT_NAME=nemotron-email
# Copy version-pinned compatible asset IDs from the model card/deployment wizard.
FOUNDRY_MODEL_ID=REPLACE_ME
FOUNDRY_DEPLOYMENT_TEMPLATE_ID=REPLACE_ME
FOUNDRY_ACCELERATOR_TYPE=REPLACE_ME
# Number of model instances, NOT tokens/minute and NOT necessarily GPU count.
FOUNDRY_CAPACITY=1
# Set true only after checking quota, license/terms, preview limits, region and cost.
FOUNDRY_DEPLOYMENT_APPROVED=false
